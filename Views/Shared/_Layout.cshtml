@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor Accessor

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />

    <title>TeknoPortal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand text-info fw-bold" href="/">
                TeknoPortal
            </a>

            <div>

                <a href="/" class="btn btn-outline-light me-2">
                    Ana Sayfa
                </a>

                @if (Accessor.HttpContext.Session.GetString("GirisYapan") == null)
                {
                    <a href="/Auth/Giris" class="btn btn-info">
                        Yönetici Girişi
                    </a>
                }
                else
                {
                    <span class="text-white me-2">
                        @Accessor.HttpContext.Session.GetString("GirisYapan")
                    </span>

                    <a href="/Auth/Cikis" class="btn btn-danger">
                        Çıkış Yap
                    </a>
                }

            </div>

        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

</body>
</html>